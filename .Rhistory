p_pub <- ggplot(
df_surv_complete,
aes(x = time, y = estimate, color = treatment_label, linetype = treatment_label, shape = treatment_label)
) +
geom_step(linewidth = 0.8) +
geom_point(size = 2.2) +
facet_wrap(~ substrate_label, ncol = 2) +
scale_x_continuous(breaks = seq(0, max(df_surv_complete$time), by = 1), limits = c(0, max(df_surv_complete$time))) +
scale_y_continuous(limits = c(0, 1.02), labels = scales::percent_format(accuracy = 1)) +
scale_color_manual(values = c("Control" = "black", "Tween 80" = "gray40",
"Isolate i15" = "#55DDE0", "Isolate i33" = "#33658A",
"Isolate i94" = "#2F4858", "Isolate i103" = "#F6AE2D",
"Isolate i124" = "#F26419")) +
# Estilos de Linha
scale_linetype_manual(values = c("Control" = "dashed", "Tween 80" = "dotted",
"Isolate i15" = "solid", "Isolate i33" = "solid",
"Isolate i94" = "solid", "Isolate i103" = "solid",
"Isolate i124" = "solid")) +
scale_shape_manual(values = c("Control" = 16,
"Tween 80" = 16,
"Isolate i15" = 16,
"Isolate i33" = 16,
"Isolate i94" = 16,
"Isolate i103" = 16,
"Isolate i124" = 16)) +
labs(
x = "Time post-inoculation (days)",
y = "Survival probability",
color = "Treatment",
linetype = "Treatment",
shape = "Treatment"
) +
theme_classic(base_size = 12, base_family = "sans") +
theme(
strip.background = element_rect(fill = "gray95", color = "black", linewidth = 0.5),
strip.text = element_text(face = "italic", size = 11),
axis.title = element_text(face = "bold"),
axis.text = element_text(color = "black"),
legend.position = "bottom",
legend.title = element_text(face = "bold"),
legend.box = "horizontal",
panel.grid.major.y = element_line(color = "gray90", linewidth = 0.2)
) +
guides(color = guide_legend(nrow = 2, byrow = TRUE))
