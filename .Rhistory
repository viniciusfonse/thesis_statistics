install.packages("agricolae") #Instala o pacote "agricolae" (pacote para análises estatísticas em pesquisas agrícolas)
install.packages("tidyverse") #Esse pacote se trata de uma coleção de pacote interrelacionados e projetados para a ciência de dados
if (!require("pacman")) install.packages("pacman")
dados <- read_excel("isolates_selection_bioassay_1.xlsx")
library(readxl)
library(dplyr)
library(survival)
library(survminer)
install.packages("coxme")
library(coxme)
library(lme4)
library(car)
library(emmeans) #comparações mútiplas post-hoc
install.packages("emmeans")
library(emmeans) #comparações mútiplas post-hoc
install.packages("drc")
library(drc)# Curvas dose-resposta e cálculo de TL50
dados <- read_excel("isolates_selection_bioassay_1.xlsx")
View(dados)
# Definir variáveis categóricas e criar ID único por placa de Petri
dados <- dados %>%
mutate(
substrate = as.factor(substrate),
treatment = as.factor(treatment),
inter     = as.factor(inter),
rep       = as.factor(rep),
id_placa  = as.factor(paste(inter, rep, sep = "_"))
)
#criando o objeto de sobrevivência
surv_obj <- Surv(time = dados$dias, event = dados$mortality)
#curvas de sobrevivência por tratamento de interação
fit_km <- survfit(surv_obj ~ inter, data = dados)
#teste de Log-Rank
logrank_test <- survdiff(surv_obj ~ inter, data = dados)
print(logrank_test)
#plotando a curva de sobrevivência
ggsurvplot(
fit_km,
data = dados,
pval = TRUE,
risk.table = FALSE,
legend.title = "Tratamentos",
xlab = "Dias após exposição",
ylab = "Probabilidade de Sobrevivência",
ggtheme = theme_minimal()
)
fit_cox <- coxme(surv_obj ~ substrate * treatment + (1 | id_placa), data = dados)
summary(fit_cox)
fit_glmm <- glmer(
mortality ~ substrate * treatment + (1 | id_placa),
data = dados,
family = binomial(link = "logit")
)
# Tabela ANOVA (Tipo III)
car::Anova(fit_glmm, type = "III")
# Teste de Comparações Múltiplas (Pós-hoc de Tukey)
post_hoc <- emmeans(fit_glmm, ~ treatment | substrate, type = "response")
pairs(post_hoc, adjust = "tukey")
fit_tl50 <- drm(
mortality ~ dias,
curveid = inter,
data = dados,
fct = LL.2() # Modelo Log-Logístico de 2 parâmetros
)
# Cálculo do TL50 com intervalos de confiança
ED(fit_tl50, 50, interval = "delta")
lt50_table <- quantile(fit_km, probs = 0.5)$quantile %>%
as.data.frame() %>%
rownames_to_column(var = "Treatment_Group") %>%
rename(LT50_days = `.`)
library(tidyverse)
lt50_table <- quantile(fit_km, probs = 0.5)$quantile %>%
as.data.frame() %>%
rownames_to_column(var = "Treatment_Group") %>%
rename(LT50_days = `.`)
lt50_matrix <- quantile(fit_km, probs = 0.5)$quantile
lt50_table <- data.frame(
Treatment_Group = gsub("inter=", "", rownames(lt50_matrix)),
LT50_days = lt50_matrix[, 1],
row.names = NULL
)
print(lt50_table)
